from pyset import TokenBoundaryDetector

detector = TokenBoundaryDetector(language="en")

# Simple usage
text = "Hello world. How are you? I'm doing great!"
sentences = detector.split(text)

print(sentences)
# ['Hello world.', 'How are you?', "I'm doing great!"]


